BOT_AUDIO_OPENVIDU_URL=http://127.0.0.1:5443/openvidu/api/
BOT_AUDIO_OPENVIDU_SECRET=replace-with-openvidu-secret
BOT_AUDIO_MAX_STREAMS=32
BOT_AUDIO_STATUS_PORT=8097
# Per-node HTTPS callback; serverNum must match this OpenVidu node in AS.
BOT_AUDIO_RESULT_URL=https://YOUR-API-HOST/Api/Bots/AudioResult.ashx?serverNum=1
BOT_AUDIO_DRY_RUN_DIR=/data/stt-dry-run
# Only used for assignments explicitly requesting Azure. Dry-run never calls Azure.
BOT_AUDIO_AZURE_REGION=
BOT_AUDIO_AZURE_KEY=

[Unit]
Description=Bounded Kurento native cleanup stall capture (opt-in)
After=docker.service

[Service]
Type=simple
# Follow the newest timestamp-named native log across rotation and restarts.
# Separate from watchdog: it must never be an ExecStartPre/ExecStop dependency.
ExecStart=/usr/bin/python3 /opt/openvidu/diagnostics/kms-stall-stacks.py --log /opt/openvidu/kurento-logs --native-stacks
Restart=on-failure
RestartSec=30
TimeoutStopSec=3
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
